# Set a hostname whose DNS A/AAAA record points to your server; omit https://.
DOMAIN=kolam.example.com
BASIC_AUTH_USER=admin
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Paste the generated bcrypt hash between single quotes to preserve dollar signs.
BASIC_AUTH_HASH='REPLACE_WITH_GENERATED_BCRYPT_HASH'
